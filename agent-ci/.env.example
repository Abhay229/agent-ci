# Set to 1 to use real LLM calls via OpenRouter (requires API key below).
# Leave unset or 0 for mock mode (default, no API key needed).
AGENT_CI_LIVE=0

# Set to 1 to use keyword-based mock RAG in CI/tests (no Chroma required).
AGENT_CI_MOCK_RAG=0

# Set to 1 to run optional AI root-cause analysis on regressions (works in mock mode too).
# CLI flags (--root-cause) take precedence when explicitly passed.
AGENT_CI_ROOT_CAUSE=0

# Set to 1 to generate related AI test cases when regressions occur (mock mode supported).
# CLI flags (--generate-tests) take precedence when explicitly passed.
AGENT_CI_GENERATE_TESTS=0

# Required only when AGENT_CI_LIVE=1. Never commit real keys — copy this file to .env locally.
OPENROUTER_API_KEY=sk-or-your-key-here
